---
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABELS } from '../lib/content';

interface Props {
  status: CollectionEntry<'properties'>['data']['status'];
  class?: string;
}

const { status, class: className } = Astro.props;

const tone: Record<Props['status'], string> = {
  'for-sale': 'bg-accent text-paper',
  'under-offer': 'bg-ink text-paper',
  sold: 'bg-line text-ink',
  'to-let': 'bg-accent-soft text-accent-dark',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-3 py-1 text-[0.68rem] font-semibold tracking-[0.1em] uppercase',
    tone[status],
    className,
  ]}
>
  {STATUS_LABELS[status]}
</span>

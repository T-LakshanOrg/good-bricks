---
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABELS } from '../lib/content';

interface Props {
  status: CollectionEntry<'properties'>['data']['status'];
  class?: string;
}

const { status, class: className } = Astro.props;
---

<!-- The colour lives in global.css, keyed on this data-status slug. -->
<span class:list={['badge', className]} data-status={status}>{STATUS_LABELS[status]}</span>

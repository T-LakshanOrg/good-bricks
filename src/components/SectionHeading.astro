---
interface Props {
  title: string;
  /** A supporting line, or a link, sits to the right — never both. */
  intro?: string;
  linkHref?: string;
  linkText?: string;
  id?: string;
  /** A list page's heading is the page's h1; a home-page section's is an h2. */
  as?: 'h1' | 'h2';
}

const { title, intro, linkHref, linkText, id, as: Heading = 'h2' } = Astro.props;
const hasLink = Boolean(linkHref && linkText);
---

<div class="section-head">
  <Heading id={id}>{title}</Heading>
  {hasLink && <a class="link-arrow" href={linkHref}>{linkText} &rarr;</a>}
  {!hasLink && intro && <p>{intro}</p>}
</div>

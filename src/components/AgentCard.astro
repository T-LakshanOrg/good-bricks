---
import type { CollectionEntry } from 'astro:content';
import { agentHref } from '../lib/content';

interface Props {
  agent: CollectionEntry<'agents'>;
}

const { agent } = Astro.props;
const { name, role, photo, bioShort } = agent.data;
---

<!--
  Phone and email are deliberately not on the card: the card is one stretched
  link, so any second link inside it would sit under that overlay and be
  unclickable. Contact details live on the agent's own page.
-->
<article class="card">
  <div class="card__media card__media--square">
    <img src={photo} alt={name} width="800" height="800" loading="lazy" decoding="async" />
  </div>

  <div class="card__body">
    <h3><a class="card__link" href={agentHref(agent)}>{name}</a></h3>
    <p class="agent-role">{role}</p>
    <p class="card__meta">{bioShort}</p>
  </div>
</article>

<style>
  h3 {
    font-size: 1.125rem;
  }

  /*
    The role sits under the name rather than opposite it: these job titles run
    to "Director & Head of Residential Sales", which will not share a baseline
    row with a name at card width.
  */
  .agent-role {
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
</style>

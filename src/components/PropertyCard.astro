---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import { formatArea, formatPrice, propertyHref } from '../lib/content';

interface Props {
  property: CollectionEntry<'properties'>;
  /** The first card above the fold on a page can afford to load eagerly. */
  loading?: 'eager' | 'lazy';
}

const { property, loading = 'lazy' } = Astro.props;
const { title, image, city, price, currency, status, type, bedrooms, bathrooms, area } =
  property.data;
---

<article class="card" data-status={status} data-type={type}>
  <div class="card__media">
    <img
      src={image}
      alt={`${title}, ${city}`}
      width="1200"
      height="900"
      loading={loading}
      decoding="async"
    />
    <StatusBadge status={status} class="card__badge" />
  </div>

  <div class="card__body">
    <div class="card__row">
      <h3><a class="card__link" href={propertyHref(property)}>{title}</a></h3>
      <span class="card__price">{formatPrice(price, currency, status)}</span>
    </div>
    <p class="card__meta">{city}</p>
  </div>

  <ul class="stats">
    <!-- Floor area: a corner-marked frame. -->
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M3 9V3h6M21 15v6h-6M21 9V3h-6M3 15v6h6"></path></svg
      >
      {formatArea(area)}
    </li>
    <!-- A plot has no bedrooms; printing "0 bed" would read as a mistake. -->
    {
      bedrooms > 0 && (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2 17v-5h20v5M2 17v3M22 17v3M4 12V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4" />
          </svg>
          {bedrooms} bed
        </li>
      )
    }
    {
      bathrooms > 0 && (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 12h18v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3ZM6 12V6a2 2 0 0 1 4 0M6 19l-1 2M18 19l1 2" />
          </svg>
          {bathrooms} bath
        </li>
      )
    }
  </ul>
</article>

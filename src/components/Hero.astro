---
interface Props {
  heading: string;
  subheading: string;
  ctaText: string;
  ctaLink: string;
  image: string;
}

const { heading, subheading, ctaText, ctaLink, image } = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <h1>{heading}</h1>
    <div class="hero__foot">
      <p>{subheading}</p>
      <a class="btn" href={ctaLink}>{ctaText} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>

  <!--
    Full-bleed, outside the wrap. The photograph is decorative here — the h1
    directly above it already says what the page is — so alt is empty.
  -->
  <div class="hero__media">
    <img
      src={image}
      alt=""
      width="1800"
      height="771"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__foot p {
    max-width: 44ch;
    color: var(--ink-muted);
  }

  .hero__media {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  /* A 21/9 band is a letterbox slot on a phone; give it more height there. */
  @media (max-width: 40rem) {
    .hero__media {
      aspect-ratio: 4 / 3;
    }
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

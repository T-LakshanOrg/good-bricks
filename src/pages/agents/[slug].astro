---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { byFeaturedThenNewest } from '../../lib/content';

export const getStaticPaths = (async () => {
  const agents = await getCollection('agents');
  const properties = await getCollection('properties');

  return agents.map((agent) => ({
    params: { slug: agent.id },
    props: {
      agent,
      // The reference resolves to the agent's entry id, so this is a direct match.
      properties: properties
        .filter((property) => property.data.agent.id === agent.id)
        .sort(byFeaturedThenNewest),
    },
  }));
}) satisfies GetStaticPaths;

const { agent, properties } = Astro.props;
const { Content } = await render(agent);
const a = agent.data;
const firstName = a.name.split(' ')[0];
const socials = Object.entries(a.socials ?? {}).filter(([, href]) => Boolean(href)) as [
  string,
  string,
][];
const socialLabels: Record<string, string> = {
  linkedin: 'LinkedIn',
  x: 'X',
  instagram: 'Instagram',
};
---

<BaseLayout title={a.name} description={a.bioShort} image={a.photo}>
  <section class="section section--lead">
    <div class="wrap">
      <a class="back" href="/agents">&larr; The whole team</a>

      <div class="profile">
        <div class="profile__photo">
          <img
            src={a.photo}
            alt={a.name}
            width="900"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="profile__body">
          <p class="field-label">{a.role}</p>
          <h1>{a.name}</h1>
          <p class="profile__bio">{a.bioShort}</p>

          <dl class="profile__contact fields">
            <div>
              <dt>Phone</dt>
              <dd><a href={`tel:${a.phone.replace(/\s+/g, '')}`}>{a.phone}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${a.email}`}>{a.email}</a></dd>
            </div>
            {
              socials.length > 0 && (
                <div>
                  <dt>Elsewhere</dt>
                  <dd class="profile__socials">
                    {socials.map(([key, href]) => (
                      <a href={href} target="_blank" rel="noopener noreferrer">
                        {socialLabels[key] ?? key}
                      </a>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          <div class="rich-text">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="wrap">
      <SectionHeading
        title={`${firstName}'s properties`}
        linkHref="/properties"
        linkText="All properties"
      />

      {
        properties.length > 0 ? (
          <div class="grid">
            {properties.map((property) => (
              <PropertyCard property={property} />
            ))}
          </div>
        ) : (
          <p class="empty">{firstName} has no properties listed at the moment.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .profile {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .profile {
      grid-template-columns: 22rem minmax(0, 1fr);
    }
  }

  .profile__photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .profile__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile__body .field-label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .profile__bio {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
    max-width: 44ch;
  }

  .profile__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 2rem 0;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  /* Contact details are not headings, so they keep the body face. */
  .profile__contact dd {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    word-break: break-word;
  }

  .profile__contact a:hover {
    border-bottom: 1px solid var(--ink);
  }

  .profile__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .empty {
    color: var(--ink-muted);
  }
</style>

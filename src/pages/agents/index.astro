---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AgentCard from '../../components/AgentCard.astro';

const agents = (await getCollection('agents')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en-GB')
);
---

<BaseLayout title="Our team" description="The people you will actually be dealing with.">
  <section class="section section--lead">
    <div class="wrap">
      <SectionHeading
        as="h1"
        title="Our team"
        intro="The people you will actually be dealing with. Call any of them directly."
      />
      <div class="grid grid--four">
        {agents.map((agent) => <AgentCard agent={agent} />)}
      </div>
    </div>
  </section>
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { TYPE_LABELS, agentHref, formatArea, formatPrice, propertySlug } from '../../lib/content';

export const getStaticPaths = (async () => {
  const properties = await getCollection('properties');
  return properties.map((property) => ({
    params: { slug: propertySlug(property) },
    props: { property },
  }));
}) satisfies GetStaticPaths;

const { property } = Astro.props;
const d = property.data;
const { Content } = await render(property);
const agent = await getEntry(d.agent);

/**
 * The featured image always leads, whether or not the gallery repeats it —
 * a gallery listing only the other views must not drop it from the page.
 */
const images = [d.image, ...(d.gallery ?? []).filter((photo) => photo !== d.image)];
const [leadImage, ...rest] = images;

// Price and status are already in the header, so they are left out here.
const specs = [
  { label: 'Type', value: TYPE_LABELS[d.type] },
  d.bedrooms > 0 ? { label: 'Bedrooms', value: String(d.bedrooms) } : null,
  d.bathrooms > 0 ? { label: 'Bathrooms', value: String(d.bathrooms) } : null,
  { label: 'Floor area', value: formatArea(d.area) },
  { label: 'Postcode', value: d.postcode },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout
  title={d.title}
  description={`${d.address}, ${d.city} — ${formatPrice(d.price, d.currency, d.status)}`}
  image={d.image}
>
  <article class="section section--lead">
    <div class="wrap">
      <a class="back" href="/properties">&larr; All properties</a>

      <header class="head">
        <div>
          <StatusBadge status={d.status} class="head__badge" />
          <h1>{d.title}</h1>
          <p class="head__address">{d.address}, {d.city} {d.postcode}</p>
        </div>
        <p class="head__price">{formatPrice(d.price, d.currency, d.status)}</p>
      </header>

      <div class="gallery">
        <div class="gallery__lead">
          <img
            src={leadImage}
            alt={`${d.title} — ${d.address}, ${d.city}`}
            width="1800"
            height="1125"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        {
          rest.length > 0 && (
            <div class="gallery__rest">
              {rest.map((src, i) => (
                <img
                  src={src}
                  alt={`${d.title} — photo ${i + 2}`}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="detail">
        <div class="detail__main">
          <dl class="specs fields">
            {
              specs.map((spec) => (
                <div>
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </div>
              ))
            }
          </dl>

          <div class="rich-text">
            <Content />
          </div>

          {
            d.features && d.features.length > 0 && (
              <section class="features">
                <h2>Key features</h2>
                <ul>
                  {d.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>

        {
          agent && (
            <aside class="agent">
              <div class="agent__photo">
                <img
                  src={agent.data.photo}
                  alt=""
                  width="800"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="agent__body">
                <p class="field-label">Listing agent</p>
                <h2>
                  <a href={agentHref(agent)}>{agent.data.name}</a>
                </h2>
                <p class="agent__role">{agent.data.role}</p>

                <p class="agent__contact">
                  <a href={`tel:${agent.data.phone.replace(/\s+/g, '')}`}>{agent.data.phone}</a>
                  <a href={`mailto:${agent.data.email}`}>{agent.data.email}</a>
                </p>

                <a class="btn btn--ghost" href={agentHref(agent)}>
                  About {agent.data.name.split(' ')[0]}
                </a>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Flush left with the title below it — the card's inset padding is wrong
     once the badge is sitting on the page rather than on a photograph. */
  .head :global(.head__badge) {
    padding-left: 0;
    margin-bottom: 0.75rem;
  }

  .head__address {
    margin-top: 0.75rem;
    color: var(--ink-muted);
  }

  .head__price {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .gallery {
    display: grid;
    gap: 0.75rem;
  }

  .gallery__lead {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  /* A fixed track, not auto-fit: a property with one extra photo would
     otherwise get a single thumbnail stretched as wide as the lead image. */
  .gallery__rest {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .gallery__rest {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery__rest img {
    aspect-ratio: 4 / 3;
    background: var(--bg-sunken);
  }

  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .detail {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }

    .agent {
      position: sticky;
      top: 6.5rem;
    }
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1.5rem;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .features {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .features h2 {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
  }

  .features ul {
    display: grid;
    gap: 0.75rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .features li {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .agent {
    border: 1px solid var(--line);
    background: var(--bg);
  }

  /* Decorative: the name and the button below it both link to the agent, so
     the photograph is not a third link to the same place. */
  .agent__photo {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .agent__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .agent__body {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .agent h2 {
    font-size: 1.25rem;
  }

  .agent h2 a:hover {
    border-bottom: 1px solid var(--ink);
  }

  .agent__role,
  .agent__contact {
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .agent__contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    word-break: break-word;
  }

  .agent__contact a:hover {
    color: var(--ink);
  }

  .agent .btn {
    margin-top: 0.5rem;
  }
</style>

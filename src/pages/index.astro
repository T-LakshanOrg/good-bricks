---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PropertyCard from '../components/PropertyCard.astro';
import AgentCard from '../components/AgentCard.astro';
import { byFeaturedThenNewest } from '../lib/content';

const homeEntry = await getEntry('home', 'home');
if (!homeEntry) throw new Error('Missing src/content/settings/home.yml');
const home = homeEntry.data;

const properties = (await getCollection('properties'))
  .sort(byFeaturedThenNewest)
  .slice(0, home.latestPropertiesCount);

const agents = (await getCollection('agents')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en-GB')
);
---

<BaseLayout bareTitle description={home.heroSubheading} image={home.heroImage}>
  <Hero
    heading={home.heroHeading}
    subheading={home.heroSubheading}
    ctaText={home.heroCtaText}
    ctaLink={home.heroCtaLink}
    image={home.heroImage}
  />

  <section class="section">
    <div class="wrap">
      <SectionHeading
        title={home.latestPropertiesHeading}
        linkHref="/properties"
        linkText="All properties"
      />
      <div class="grid">
        {properties.map((property) => <PropertyCard property={property} />)}
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="wrap">
      <SectionHeading title={home.agentsHeading} linkHref="/agents" linkText="The whole team" />
      <div class="grid grid--four">
        {agents.map((agent) => <AgentCard agent={agent} />)}
      </div>
    </div>
  </section>
</BaseLayout>

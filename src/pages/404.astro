---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const siteEntry = await getEntry('site', 'site');
const navItems = siteEntry?.data.navItems ?? [];
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <section class="section section--lead">
    <div class="wrap not-found">
      <p class="field-label">Error 404</p>
      <h1>We could not find that page</h1>
      <p class="not-found__body">
        The link may be out of date, or the property may no longer be listed. Try one of these
        instead.
      </p>

      <div class="not-found__actions">
        <a class="btn" href="/">Home</a>
        {navItems.map((item) => <a class="btn btn--ghost" href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 44rem;
  }

  .not-found .field-label {
    display: block;
    margin-bottom: 1rem;
  }

  .not-found__body {
    margin-top: 1.5rem;
    max-width: 46ch;
    color: var(--ink-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
</style>
